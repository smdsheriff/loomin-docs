# =============================================================================
# Loomin-Docs — example environment configuration
# =============================================================================
# Copy to backend/.env for local (non-Docker) development:
#     cp .env.example backend/.env
#
# When running under Docker Compose these values come from the `environment:`
# block in deploy/docker-compose.yml instead — the defaults below assume the
# container filesystem layout (/data), which will NOT exist on a laptop.
# See the "Local Development" section of README.md for laptop-friendly paths.
# =============================================================================

# --- Storage -----------------------------------------------------------------

# SQLAlchemy async connection string (documents, versions, chat, file metadata).
# Local development: sqlite+aiosqlite:///./loomin.db
DATABASE_URL=sqlite+aiosqlite:////data/loomin.db

# Directory holding the serialized FAISS index.
# Local development: ./.local/faiss_index
FAISS_INDEX_PATH=/data/faiss_index

# Directory holding uploaded source files.
# Local development: ./.local/uploads
UPLOAD_DIR=/data/uploads

# --- Ollama ------------------------------------------------------------------

# URL of the Ollama server. Inside Compose this is the service name;
# running the backend directly on your machine, use http://localhost:11434
OLLAMA_BASE_URL=http://ollama:11434

# Model preselected in the sidebar dropdown. Must be available in Ollama.
DEFAULT_MODEL=llama3.2:1b

# --- Embeddings --------------------------------------------------------------

# Either a sentence-transformers model name (downloaded on first use) or an
# absolute path to a pre-downloaded model directory. Air-gapped deployments
# MUST use a path — the container has no internet access to fetch it.
# Compose sets this to /models/all-MiniLM-L6-v2 from the embedding-model volume.
EMBEDDING_MODEL_PATH=all-MiniLM-L6-v2

# --- RAG tuning --------------------------------------------------------------

# Top-K chunks pulled from FAISS for each query. Higher values give the model
# more context but consume more of the context window.
MAX_CHUNKS_RETRIEVED=5

# Minimum cosine similarity for a chunk to be included. Raise it if the
# assistant cites loosely related passages; lower it if it misses relevant ones.
MIN_SIMILARITY_SCORE=0.25

# Number of prior chat messages carried into multi-turn context.
MAX_CONVERSATION_HISTORY=100

# --- Pipeline orchestration --------------------------------------------------

# Route /api/chat through the LangGraph RAG pipeline (app/rag/graph.py) instead
# of the original inline pipeline. Both produce identical output and SSE framing.
# Default false. Set true to opt in; flip back to false to roll back instantly.
# When false, langgraph is not even imported, so the legacy path has no new deps.
USE_LANGGRAPH=false

# --- Frontend (build-time, read by Vite) -------------------------------------

# Leave empty to use same-origin requests via the Nginx or Vite proxy.
# Set only when the frontend must reach a backend on a different origin.
# VITE_API_URL=http://localhost:8000
